# --- Phase 1: collectors ---

# SerpApi (Google Trends backend) — https://serpapi.com/manage-api-key
# Free tier: 100 searches/month. The quota guard hard-stops before the cap.
SERPAPI_KEY=

# Reddit OAuth script app — https://www.reddit.com/prefs/apps (type: "script")
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Required format: <platform>:<app-name>:<version> (by /u/<your-username>)
REDDIT_USER_AGENT=windows:trend-scout:0.1.0 (by /u/YOUR_USERNAME)

# AliExpress Open Platform — https://openservice.aliexpress.com/
# Register an app with the Affiliate API permission set.
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
# Affiliate tracking ID from the AliExpress Portals dashboard
ALIEXPRESS_TRACKING_ID=

# Supabase — used in Phase 1 only for the API quota table (sql/001_quota.sql).
# Phase 2 moves all datapoint storage here. Leave blank to fall back to a
# local quota file (fine on your laptop, NOT fine on GitHub Actions where
# the filesystem resets every run).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Phase 3 (not used yet) ---
ANTHROPIC_API_KEY=
